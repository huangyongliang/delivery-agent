# Copy to .env and fill in real values locally. Never commit .env.
# Docker Compose reads this file for variable substitution. Defaults keep mock mode working.

# --- Agent ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_PATH=data/delivery-agent.db
LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=600
HTTP_TIMEOUT_SECONDS=30

# mock | openai | anthropic | http | none
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2

# OpenAI-compatible Chat Completions (OpenAI, vLLM, Ollama /v1, DeepSeek, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_JSON_MODE=true

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

# Generic HTTP adapter. HTTP_LLM_STYLE=openai expects Chat Completions JSON.
# HTTP_LLM_STYLE=prompt posts {"model","prompt"} and reads text/content/response.
HTTP_LLM_URL=
HTTP_LLM_API_KEY=
HTTP_LLM_MODEL=generic
HTTP_LLM_STYLE=openai

# --- GitLab ---
# mock | live
GITLAB_MODE=mock
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_TOKEN=dev-gitlab-token
GITLAB_TRIGGER_PIPELINE=true

# --- Jenkins ---
# mock | live
JENKINS_MODE=mock
JENKINS_BASE_URL=http://localhost:8081
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB=delivery-pipeline
JENKINS_WEBHOOK_TOKEN=dev-jenkins-token
JENKINS_POLL_INTERVAL_SECONDS=2

# --- Docker shipping ---
# mock | local     local shells out to the docker CLI
DOCKER_MODE=mock
DOCKER_REGISTRY=localhost:5000
DOCKER_NAMESPACE=delivery
DOCKER_CONTEXT=examples/sample-product
DOCKER_DOCKERFILE=Dockerfile
# jenkins: Jenkinsfile builds and pushes; the agent confirms the image in the console log
# agent: the agent builds and pushes DOCKER_CONTEXT after Jenkins succeeds
SHIP_STRATEGY=jenkins
